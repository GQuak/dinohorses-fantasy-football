# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables instead.

# --- Season ---
SEASON_YEAR=2026

# --- Branding ---
# Shown in the nav bar, login page, and browser tab title.
NEXT_PUBLIC_SITE_NAME=My Fantasy Football

# --- League 1 ---
LEAGUE_1_ID=123456
LEAGUE_1_NAME=My League

# --- League 2 ---
LEAGUE_2_ID=654321
LEAGUE_2_NAME=My Other League

# --- ESPN auth (required for private leagues) ---
# Shared cookies used for both leagues, if the same ESPN account is in both.
ESPN_S2=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}

# Only set these if League 2 needs a *different* ESPN account's cookies.
# LEAGUE_2_ESPN_S2=
# LEAGUE_2_SWID=

# --- Site access ---
# Password required to view the dashboard. Leave unset to disable the gate
# (fine for local dev; not recommended once deployed publicly).
SITE_PASSWORD=change-me

# Random string used to sign the login cookie. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=

# --- Analytics (optional) ---
# Google Analytics 4 Measurement ID (Admin -> Data Streams -> your stream,
# in your GA4 property). Leave unset to skip GA entirely -- Vercel
# Analytics (no setup needed beyond enabling it in your Vercel project's
# Analytics tab) works regardless.
NEXT_PUBLIC_GA_ID=
